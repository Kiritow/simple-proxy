servers:
- server_name: example.com        # several names separated by spaces
  # enable: true
  # listen_port: 8443             # default: 80, or 443 with https
  # https: true                   # default: true if cert_name is set
  # cert_name: "*.example.com"    # acme.sh cert, default: server_name
  gzip: true
  options:
  - client_max_body_size 64m
  default:
    # path: /
    ip: 127.0.0.1
    port: 3000
    # websocket: true
    # disable_cache: true
    # realtime: true
    # options:
    # - add_header X-Example "value"
  locations:
  - path: /api
    # ip and port default to those of the default location
    port: 3001
    websocket: true
    disable_cache: true
    realtime: true
    options:
    - add_header X-Example "value"
    - key: proxy_read_timeout     # the {key, value} form also works
      value: 300s
