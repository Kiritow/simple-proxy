{{- /* Rendered with confData. Directives are printed with directive.String. */ -}}
# Auto generated at {{ .GeneratedAt.Format "2006-01-02 15:04:05" }}
{{- with .ServerNamesHashBucketSize }}
server_names_hash_bucket_size {{ . }};
{{- end }}
map $http_upgrade $connection_upgrade {
  default upgrade;
  "" close;
}
server {
  listen 80 default_server;
  server_name _;
  {{- with .ACMEChallenge }}
  location {{ .Match }} {
    {{- range .Directives }}
    {{ . }};
    {{- end }}
  }
  location / {
    return 444;
  }
  {{- else }}
  return 444;
  {{- end }}
}
server {
  listen 443 ssl default_server;
  server_name _;
  ssl_certificate {{ .FallbackCert }};
  ssl_certificate_key {{ .FallbackKey }};
  return 444;
}
{{- template "servers" .Servers }}
{{- define "servers" }}
{{- range . }}
{{- if .Raw }}
{{ .Raw }}
{{- else }}
server {
  listen {{ .Listen }};
  server_name {{ .Name }};
  {{- range .Directives }}
  {{ . }};
  {{- end }}
  {{- range .Locations }}
  location {{ .Match }} {
    {{- range .Directives }}
    {{ . }};
    {{- end }}
  }
  {{- end }}
}
{{- end }}
{{- end }}
{{- end }}
